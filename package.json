{
  "license": "MIT",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "setup-devnet": "npx ts-node --project tsconfig.json scripts/setup-devnet-markets.ts",
    "fund-devnet": "npx ts-node --project tsconfig.json scripts/fund-devnet.ts",
    "attest-devnet": "npx ts-node --project tsconfig.json scripts/attester.ts",
    "check-devnet": "npx ts-node --project tsconfig.json scripts/check-devnet-health.ts --cluster=devnet",
    "force-close": "npx ts-node --project tsconfig.json scripts/force-close-bot.ts",
    "resolve-market": "npx ts-node --project tsconfig.json scripts/resolve-market.ts",
    "app:build": "npm --prefix app run build",
    "app:start": "npm --prefix app run start",
    "start": "npm run attest-devnet -- --cluster=devnet --interval=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0"
  }
}
