{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "sdk/src/**/*.ts",
    "scripts/**/*.ts",
    "migrations/**/*.ts"
  ],
  "exclude": ["node_modules", "app", "target", "tests"]
}
